+import { useLayoutEffect } from "react";
+
+// Engine-owned clock. One callback advances every visible instance before any view is painted.
+const clocks = new WeakMap();
+const marker = "#nls-sequence=";
+const descriptors = new Map();
+function sequence(src) {
+    if (typeof src !== "string" || !src.includes(marker)) return null;
+    if (descriptors.has(src)) return descriptors.get(src);
+    try {
+        const data = JSON.parse(decodeURIComponent(src.slice(src.indexOf(marker) + marker.length)));
+        const valid = typeof data.id === "string" && Array.isArray(data.frames) && data.frames.length > 0
+            && data.frames.every(frame => typeof frame === "string") && Number.isFinite(data.fps) && data.fps > 0 ? data : null;
+        if (descriptors.size >= 64) descriptors.delete(descriptors.keys().next().value);
+        descriptors.set(src, valid);
+        return valid;
+    } catch { return null; }
+}
+function playback(image, clip) {
+    const state = image.state.frameSequencePlayback ??= { activeId: null, clips: {} };
+    return state.clips[clip.id] ??= { elapsedMs: 0 };
+}
+export function resolveFrameSequence(src, image) {
+    const clip = sequence(src);
+    if (!clip) return src;
+    const elapsed = playback(image, clip).elapsedMs;
+    const absolute = Math.floor(elapsed * clip.fps / 1000);
+    const index = clip.loop === false ? Math.min(absolute, clip.frames.length - 1) : absolute % clip.frames.length;
+    return clip.frames[index];
+}
+export function useFrameSequence(image, state, refs, transition, resolve) {
+    useLayoutEffect(() => {
+        if (!sequence(image.state.currentSrc) && !sequence(transition?.transition._getTargetSrc()) && !sequence(transition?.transition._getPrevSrc())) return;
+        let clock = clocks.get(state);
+        if (!clock) {
+            clock = { listeners: new Set(), last: null, request: null };
+            clocks.set(state, clock);
+        }
+        let ready = false;
+        let cancelled = false;
+        const available = [image.state.currentSrc, transition?.transition._getPrevSrc(), transition?.transition._getTargetSrc()]
+            .map(sequence).filter(Boolean).flatMap(clip => clip.frames);
+        const decoded = image.frameSequenceDecoded ??= new Map();
+        const loads = [...new Set(available)].map(src => {
+            if (!decoded.has(src)) {
+                const bitmap = new window.Image();
+                bitmap.src = resolve(src);
+                decoded.set(src, bitmap.decode());
+            }
+            return decoded.get(src);
+        });
+        Promise.all(loads).then(() => { if (!cancelled) ready = true; }, error => {
+            state.logger.warn("Image", `Frame sequence could not load: ${String(error)}`);
+        });
+        let previousState = image.state;
+        const paint = delta => {
+            if (!ready || previousState !== image.state) delta = 0;
+            previousState = image.state;
+            const active = sequence(transition?.transition._getTargetSrc() ?? image.state.currentSrc);
+            const sources = refs.map((_, index) => {
+                const resolver = transition?.task.resolve[index];
+                if (!transition) return image.state.currentSrc;
+                if (!resolver || typeof resolver === "function") return null;
+                return resolver.key === "target" ? transition.transition._getTargetSrc() : transition.transition._getPrevSrc();
+            });
+            const clips = new Map();
+            for (const src of sources) { const clip = sequence(src); if (clip) clips.set(clip.id, clip); }
+            if (active) {
+                const saved = image.state.frameSequencePlayback ??= { activeId: null, clips: {} };
+                if (saved.activeId !== active.id) {
+                    saved.clips[active.id] = { elapsedMs: 0 };
+                    saved.activeId = active.id;
+                }
+            }
+            const owner = state.findElementByDisplayable(image);
+            for (const clip of clips.values()) playback(image, clip).elapsedMs += owner && !owner.suspended ? delta : 0;
+            for (let index = 0; index < refs.length; index++) {
+                const element = refs[index][0].current;
+                const src = sources[index];
+                if (!element || !sequence(src)) continue;
+                const resolved = resolve(src);
+                if (element.getAttribute("src") !== resolved) element.setAttribute("src", resolved);
+            }
+            if (!transition && active) {
