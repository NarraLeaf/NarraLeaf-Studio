{
  "manifestVersion": 2,
  "id": "narraleaf.gallery",
  "name": "Gallery",
  "version": "3.3.0",
  "description": "Author the EXTRA screens - CG gallery, scene recollection, music appreciation and voice extras - and drive them from blueprint graphs.",
  "localized": {
    "zh": {
      "name": "画廊",
      "description": "制作 CG 画廊、场景回想、音乐与配音鉴赏等附加内容界面，并由蓝图驱动"
    },
    "ja": {
      "name": "ギャラリー",
      "description": "CG ギャラリー、シーン回想、音楽とボイスの鑑賞などのおまけ画面を作成し、ブループリントから制御する"
    }
  },
  "publisher": "NarraLeaf Studio",
  "entries": {
    "studio": "main.js",
    "runtime": "runtime.js"
  },
  "contributes": {
    "blueprintNodes": [
      "narraleaf.gallery.getEntries",
      "narraleaf.gallery.getVariants",
      "narraleaf.gallery.getGroups",
      "narraleaf.gallery.getStats",
      "narraleaf.gallery.add",
      "narraleaf.gallery.remove",
      "narraleaf.gallery.unlockAll",
      "narraleaf.gallery.clear",
      "narraleaf.gallery.isUnlocked",
      "narraleaf.gallery.getVariant",
      "narraleaf.gallery.getVariantCount",
      "narraleaf.gallery.getCover",
      "narraleaf.gallery.getArtworkCount",
      "narraleaf.gallery.getArtworkAt"
    ],
    "runtimeData": [
      "narraleaf.gallery.items"
    ],
    "runtimeCapabilities": [
      "store",
      "events",
      "locale"
    ],
    "structs": [
