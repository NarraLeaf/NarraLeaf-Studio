{
  "manifestVersion": 2,
  "id": "narraleaf.quick-save",
  "name": "Quick Save",
  "version": "1.0.0",
  "description": "Quick Save and Quick Read blueprint nodes backed by one reserved save slot.",
  "localized": {
    "zh": {
      "name": "快速存档",
      "description": "基于一个保留存档槽的快速存档与快速读档蓝图节点"
    }
  },
  "publisher": "NarraLeaf Studio",
  "entries": {
    "studio": "main.js",
    "runtime": "runtime.js"
  },
  "contributes": {
    "blueprintNodes": [
      "narraleaf.quick-save.save",
      "narraleaf.quick-save.load",
      "narraleaf.quick-save.has"
    ],
    "reservedSaveIds": [
      "narraleaf.quick-save.slot"
    ],
    "runtimeCapabilities": [
      "saves.read",
      "saves.write"
    ]
  },
  "permissions": []
}
