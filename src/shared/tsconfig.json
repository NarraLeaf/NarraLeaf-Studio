{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Each run keeps what it learned in .cache/tsc (gitignored, one file per project and per
    // checkout), so the next run rechecks only what changed. Delete the file for a cold check.
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/tsc/shared.tsbuildinfo",
    "paths": {
      "@shared/*": ["./*"]
    },
    "typeRoots": ["../../node_modules/@types", "./types"],
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
