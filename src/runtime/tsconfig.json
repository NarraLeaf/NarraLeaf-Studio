{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // No `baseUrl`: TypeScript 7 removed the option
    // (oxc-project/tsgolint#351) and every mapping below is already relative to
    // this file, which is all `baseUrl: "."` meant here.
    "paths": {
      // What this project type-checks reaches the Studio workspace (the ui-editor tests import it),
      // and from there the bundled plugins' node definitions, which import the plugin API by the
      // bare specifier an installed plugin uses. The same mapping src/renderer/tsconfig.json carries.
      // Type-checking only: the game runtime bundle never reaches those modules.
      "narraleaf-studio/plugin": ["../renderer/plugin/index.ts"],
      "@/*": ["../renderer/*"],
      "@shared/*": ["../shared/*"],
      "@services/*": ["../renderer/lib/workspace/services/*"]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../shared/types"
    ],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "./**/*",
    // The `*.css` ambient module declaration lives here; this project pulls in
    // renderer files that import stylesheets but does not include the tree it
    // sits in.
    "../renderer/global.d.ts",
    "../renderer/lib/ui-editor/**/*",
    "../renderer/lib/workspace/hooks/useAssetObjectUrl.ts",
    "../renderer/lib/workspace/hooks/useEditorFontFamily.ts",
    "../renderer/lib/workspace/hooks/useSurfacePuppetSession.ts",
    "../renderer/styles/**/*",
    "../shared/**/*"
  ]
}
