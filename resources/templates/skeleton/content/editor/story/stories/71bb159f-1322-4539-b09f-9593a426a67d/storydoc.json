          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
            "action": "dialogue",
            "characterId": "77eb07ac-4af6-48c0-80c1-7db3de78a9ce",
            "text": {
              "textId": "d24f89b5-dd27-4fd3-a9e0-9eb42d9eaa4d",
              "role": "dialogue",
              "value": "I decided last year."
            }
          }
        },
        "137c2f66-96f4-47bf-858e-e000827767f3": {
          "id": "137c2f66-96f4-47bf-858e-e000827767f3",
          "parentId": null,
          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
            "action": "dialogue",
            "characterId": "683b73ba-729c-4bc5-8c41-d641a257a1f4",
            "text": {
              "textId": "0ef2885e-0186-4327-b43f-ee9676c2a33a",
              "role": "dialogue",
              "value": "So it is my turn."
            }
          }
        },
        "f1658534-73c0-4766-9bed-b37cf9216e0e": {
          "id": "f1658534-73c0-4766-9bed-b37cf9216e0e",
