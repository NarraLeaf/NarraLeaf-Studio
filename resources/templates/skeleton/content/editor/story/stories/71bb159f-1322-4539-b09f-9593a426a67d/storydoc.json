            "characterId": "683b73ba-729c-4bc5-8c41-d641a257a1f4",
            "text": {
              "textId": "3bb15660-8cd1-4d06-b8f9-6d3bb2d3b086",
              "role": "dialogue",
              "value": "It has two. One of them is just slow."
            }
          }
        },
        "2171b783-dd7e-4582-89e5-2885d7d9ea3a": {
          "id": "2171b783-dd7e-4582-89e5-2885d7d9ea3a",
          "parentId": null,
          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
