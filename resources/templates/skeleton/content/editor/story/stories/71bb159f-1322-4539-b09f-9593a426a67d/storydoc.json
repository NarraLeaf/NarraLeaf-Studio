            "text": {
              "textId": "d8394864-327a-4c4f-bcec-8521d44a9b09",
              "role": "narration",
              "value": "The clubroom is a classroom nobody claimed. Four desks pushed together, one window that will not close."
            }
          }
        },
        "b084c36a-6107-47e0-94c2-69cde115ad7e": {
          "id": "b084c36a-6107-47e0-94c2-69cde115ad7e",
