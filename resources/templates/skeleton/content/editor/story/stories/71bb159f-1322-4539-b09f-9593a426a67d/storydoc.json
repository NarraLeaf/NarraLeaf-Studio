              "textId": "504bea55-21b8-4b55-b6b7-ec75ff4f1fe6",
              "role": "dialogue",
              "value": "You're late."
            }
          }
        },
        "502b0cb8-c336-4e4b-9b5b-a64e8fce60b3": {
          "id": "502b0cb8-c336-4e4b-9b5b-a64e8fce60b3",
