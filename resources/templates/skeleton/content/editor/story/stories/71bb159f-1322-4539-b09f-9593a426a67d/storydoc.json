            "characterId": "77eb07ac-4af6-48c0-80c1-7db3de78a9ce",
            "text": {
              "textId": "b86c0033-9139-453a-bba4-664f3d2c812c",
              "role": "dialogue",
              "value": "One and a half. You keep leaving before it gets dark."
            }
          }
        },
