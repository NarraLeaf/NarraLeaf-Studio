          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
            "action": "dialogue",
            "characterId": "77eb07ac-4af6-48c0-80c1-7db3de78a9ce",
            "text": {
              "textId": "f01d556e-e725-4702-b254-cc41352e816b",
              "role": "dialogue",
              "value": "Third time this week. I was starting to think the club had one member."
            }
          }
        },
        "0803318f-7c62-49ca-a603-bd1b5fbb96b7": {
          "id": "0803318f-7c62-49ca-a603-bd1b5fbb96b7",
          "parentId": null,
          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
