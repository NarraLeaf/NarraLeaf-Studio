          "kind": "nodeAction",
          "payload": {
            "action": "dialogue",
            "characterId": "77eb07ac-4af6-48c0-80c1-7db3de78a9ce",
            "text": {
              "textId": "2b3a87e6-5d6f-47c2-a1be-cd3a84aaa999",
              "role": "dialogue",
              "value": "The festival is in three weeks and we have nothing."
            }
          }
        },
        "8420fa2d-5ff5-4ef2-a856-51464e040ebc": {
          "id": "8420fa2d-5ff5-4ef2-a856-51464e040ebc",
          "parentId": null,
          "childrenIds": [],
          "kind": "nodeAction",
          "payload": {
            "action": "dialogue",
            "characterId": "77eb07ac-4af6-48c0-80c1-7db3de78a9ce",
            "text": {
              "textId": "6cc6b2f7-b60e-4279-a94c-cc8860ba5287",
              "role": "dialogue",
              "value": "Which means one of us has to decide what we are making."
            }
          }
        },
        "c5634a9d-1088-4c08-bcd9-a8db90b55c16": {
          "id": "c5634a9d-1088-4c08-bcd9-a8db90b55c16",
